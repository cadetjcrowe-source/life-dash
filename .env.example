# ── Database ───────────────────────────────────────────────
# Added automatically when you connect Neon from the Vercel Marketplace.
# Use the *pooled* connection string.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# ── Login ──────────────────────────────────────────────────
# Generate with:  npm run hash-password -- "your-password"
# (format: scrypt:<salt>:<hash>, no $ signs so it's safe in env files)
AUTH_PASSWORD_HASH="scrypt:replace-me:replace-me"

# Random secret used to sign the session cookie (min 32 chars).
# Generate with:  openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# ── Morning notifications (optional) ───────────────────────
# Generate all three in the app: Settings → Morning summary → Generate the values.
# (Or: npx web-push generate-vapid-keys, and openssl rand -base64 32 for CRON_SECRET.)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" automatically.
CRON_SECRET=""
# Optional contact for push services (mailto: or https:). Defaults to your site URL.
VAPID_SUBJECT=""
